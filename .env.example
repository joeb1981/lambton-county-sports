# Supabase - get these from your Supabase project Settings > API
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-character-random-secret-here

# Admin account - the first user to sign up with this email gets admin role
OWNER_EMAIL=your@email.com

# Cron security - generate a random string
CRON_SECRET=your-cron-secret-token

# Resend email (for cron notifications) - get free key at resend.com
# Leave blank to use console.log fallback
RESEND_API_KEY=
NOTIFICATION_EMAIL=your@email.com

# Runtime
NODE_ENV=development
